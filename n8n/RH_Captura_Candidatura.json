        460
      ],
      "alwaysOutputData": true,
      "parameters": {
        "jsCode": "const base = $('Montar Prompt da IA').first().json.linha || {};\n\nlet txt = '';\ntry {\n  const blocos = $json.content || [];\n  for (const b of blocos) { if (b && b.type === 'text' && b.text) txt += b.text; }\n} catch (e) { txt = ''; }\n\nlet a = {};\nif (txt) {\n  const i = txt.indexOf('{');\n  const f = txt.lastIndexOf('}');\n  if (i >= 0 && f > i) { try { a = JSON.parse(txt.slice(i, f + 1)); } catch (e) { a = {}; } }\n}\n\nconst junta = (v) => Array.isArray(v) ? v.filter(Boolean).join(' · ') : (v || '');\n\nreturn [{ json: Object.assign({}, base, {\n  analise_ia: a.resumo || '',\n  fortes_ia: junta(a.fortes),\n  atencao_ia: junta(a.atencao),\n  perguntas_ia: junta(a.perguntas)\n}) }];"
