    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const b = $input.first().json.body || $input.first().json;\nconst nome = (b.nome || 'candidato').normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').replace(/[^A-Za-z0-9]+/g, '-').replace(/^-|-$/g, '').slice(0, 40);\nconst carimbo = (b.data || new Date().toISOString()).replace(/[:.]/g, '-');\nconst audios = Array.isArray(b.audios) ? b.audios : [];\nreturn audios.filter(a => a && a.dataUrl).map((a, i) => {\n  const m = /^data:([^;,]+)[^,]*,(.*)$/.exec(a.dataUrl) || [];\n  const mime = a.mime || m[1] || 'audio/webm';\n  const ext = a.ext || (mime.indexOf('mp4') >= 0 ? 'm4a' : mime.indexOf('ogg') >= 0 ? 'ogg' : 'webm');\n  return { json: {\n    b64: m[2] || '',\n    mime: mime,\n    filename: carimbo + '_' + nome + '_resposta-' + (i + 1) + '.' + ext,\n    pergunta: a.pergunta != null ? a.pergunta : i\n  } };\n});"
      },
