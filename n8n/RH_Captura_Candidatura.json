    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const b = $('Webhook Candidatura').first().json.body || $('Webhook Candidatura').first().json;\nconst p = b.perfil || {};\nconst t = b.triagem_texto || {};\nconst auds = Array.isArray(b.audios) ? b.audios : [];\n\nlet ids = [];\ntry { ids = $('Agregar Links').first().json.ids || []; } catch (e) { ids = []; }\nconst links = ids.filter(Boolean).map(id => 'https://drive.google.com/file/d/' + id + '/view');\n\nreturn [{ json: {\n  data: b.data || new Date().toISOString(),\n  vaga: b.vaga || '',\n  nome: b.nome || '',\n  whatsapp: b.telefone || '',\n  email: b.email || '',\n  experiencia: t.exp || '',\n  app_rastreamento: t.app || '',\n  esl: t.esl || '',\n  regiao: t.bairro || '',\n  horario_pref: t.horario || '',\n  nota_final: b.nota_final ?? '',\n  pct_triagem: b.req_pct ?? '',\n  pct_tecnico: b.tecnico_pct ?? '',\n  comunicacao: p.COM ?? '',\n  senso_urgencia: p.URG ?? '',\n  gestao_conflitos: p.CONF ?? '',\n  proatividade: p.PRO ?? '',\n  cobranca_influencia: p.COB ?? '',\n  resiliencia: p.RES ?? '',\n  registro: p.REG ?? '',\n  pct_perfil: b.perfil_pct ?? '',\n  status: b.status || '',\n  foco_perdido: b.foco_perdido ?? 0,\n  qtd_audios: auds.length,\n  link_audios: links.join('\\n'),\n  cidade: b.cidade || '',\n  bairro: b.bairro || '',\n  indicado: b.indicado || '',\n  indicado_por: b.indicado_por || ''\n} }];"
      },
