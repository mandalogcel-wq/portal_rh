      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const campos = ['data','vaga','nome','whatsapp','email','experiencia','app_rastreamento','esl','regiao','horario_pref','nota_final','pct_triagem','pct_tecnico','comunicacao','senso_urgencia','gestao_conflitos','proatividade','cobranca_influencia','resiliencia','registro','pct_perfil','status','foco_perdido','qtd_audios','link_audios','cidade','bairro','indicado','indicado_por','entrevista_em','entrevista_gestor','analise_ia','fortes_ia','atencao_ia','perguntas_ia'];\n\nconst saida = [];\nfor (const it of items) {\n  const j = it.json || {};\n  if (!String(j.nome || '').trim() && !String(j.email || '').trim()) continue;\n  const o = {};\n  for (const c of campos) { o[c] = (j[c] === null || j[c] === undefined) ? '' : j[c]; }\n  saida.push({ json: o });\n}\n\nsaida.sort((a, b) => new Date(b.json.data || 0) - new Date(a.json.data || 0));\nreturn saida;"
      }
