# ===== Portal do candidato =====
# URL do webhook de captura de candidatura no n8n (mantida secreta no servidor).
# Ex.: https://n8n-webhook.SEU-HOST/webhook/rh-candidatura
N8N_WEBHOOK_CANDIDATURA=

# ===== Painel do RH (/painel) =====
# Usuários com acesso ao painel, separados por ponto e vírgula:
#   email|hash|Nome|papel   (papel = rh ou gestor)
# Gere cada linha com: node scripts/gerar-senha.mjs "email" "Nome" rh
PAINEL_USUARIOS=

# Chave usada para assinar o cookie de sessão do painel (mínimo 24 caracteres).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Trocar essa chave desloga todo mundo.
PAINEL_SESSION_SECRET=

# Webhook do n8n que lê a planilha e devolve os candidatos para o painel.
# Ex.: https://n8n-webhook.SEU-HOST/webhook/rh-painel
N8N_WEBHOOK_PAINEL=

# Token do cabeçalho X-Painel-Token, igual ao da credencial Header Auth
# ligada ao nó "Webhook Painel" no n8n.
N8N_PAINEL_TOKEN=
